# ARGUS Environment Configuration
# Copy this file to .env and fill in your values

# PostgreSQL / Supabase Database
# For Supabase: use the connection string from your Supabase project settings
# For local: postgresql+psycopg2://argus:change_me@localhost:5432/argus
DATABASE_URL=postgresql+psycopg2://argus:change_me@localhost:5432/argus

POSTGRES_DB=argus
POSTGRES_USER=argus
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Splunk HEC (for future Phase 5)
SPLUNK_HEC_URL=http://localhost:8088
SPLUNK_HEC_TOKEN=change_me

# ARGUS API
ARGUS_API_HOST=0.0.0.0
ARGUS_API_PORT=8001

# Logging
LOG_LEVEL=INFO
